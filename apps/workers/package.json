    "@cred/storage": "workspace:*",
    "@cred/types": "workspace:*",
    "@temporalio/activity": "1.11.5",
    "drizzle-orm": "0.36.4",
    "@temporalio/client": "1.11.5",
    "@temporalio/worker": "1.11.5",
    "@temporalio/workflow": "1.11.5"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
