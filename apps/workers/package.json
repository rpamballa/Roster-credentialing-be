{
  "name": "@cred/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/worker.js",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
