# Local staging env — sourced by docker-compose.staging.yml AND by
# the API/web running via `pnpm dev` on the host.
#
# Fill ANTHROPIC_API_KEY with your Anthropic key. Everything else
# stays at the defaults below.

NODE_ENV=development
LOG_LEVEL=info

API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgres://cred:cred@localhost:5432/cred
REDIS_URL=redis://localhost:6379

SESSION_SECRET=staging-only-not-for-prod-any-32byte-string-ok

# Object storage — fake-gcs-server emulates GCS locally.
#   STORAGE_EMULATOR_HOST is dialed by the SDK inside the API.
#   STORAGE_EMULATOR_PUBLIC_URL is baked into signed URLs the browser
#   dials directly. Both point at :4443 on the host.
GCP_PROJECT_ID=cred-staging-local
GCS_BUCKET=cred-dev
STORAGE_EMULATOR_HOST=http://localhost:4443
STORAGE_EMULATOR_PUBLIC_URL=http://localhost:4443

# Anthropic direct API — set your key here.
# Vertex is NOT used on local staging (GCP_PROJECT_ID above is fake).
# The client falls back to the direct API when a real Vertex project
# isn't in play.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_OPUS=claude-opus-4-7

# Optional — email sends fall back to log-only if unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=staging@rosterhealthcare.local

# Temporal is not brought up by this compose yet.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cred-default
