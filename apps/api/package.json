    "@cred/storage": "workspace:*",
    "@cred/types": "workspace:*",
    "@hono/node-server": "1.13.7",
    "@hono/zod-validator": "0.4.2",
    "@temporalio/client": "1.11.5",
    "drizzle-orm": "0.36.4",
    "graphql": "16.10.0",
    "graphql-yoga": "5.10.4",
    "hono": "4.6.14",
    "ioredis": "5.4.1",
    "pdf-lib": "1.17.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "postgres": "3.4.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
